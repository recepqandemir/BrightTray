<Window x:Class="BrightTray.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BrightTray.UI"
        Title="BrightTray"
        Width="348"
        MinWidth="348"
        MaxWidth="348"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="FlatThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="16" Height="16" Fill="White" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrackButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="24">
                            <Border Height="4" CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrightSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="10" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource TrackButton}"
                                                  Background="#FF8A3D" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource TrackButton}"
                                                  Background="#4A4D52" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FlatThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Padding="18,16,18,18"
            CornerRadius="14"
            Background="#F21E1F22"
            BorderBrush="#33FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" />
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="{ui:Loc Brightness}"
                       Foreground="#9AA0A6"
                       FontSize="12"
                       FontFamily="Segoe UI"
                       Margin="0,0,0,10" />

            <ItemsControl x:Name="MonitorList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <Grid>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="#E8EAED"
                                           FontSize="13"
                                           FontFamily="Segoe UI"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,48,0" />
                                <TextBlock Text="{Binding PercentText}"
                                           Foreground="#FF8A3D"
                                           FontSize="13"
                                           FontFamily="Segoe UI Semibold"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Style="{StaticResource BrightSlider}"
                                    Value="{Binding Percent, Mode=TwoWay}"
                                    Margin="0,6,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="ScanningText"
                       Visibility="Collapsed"
                       Foreground="#BDC1C6"
                       FontSize="12.5"
                       FontFamily="Segoe UI"
                       Text="{ui:Loc Scanning}" />

            <TextBlock x:Name="SkippedText"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       Foreground="#F28B82"
                       FontSize="12"
                       FontFamily="Segoe UI" />

            <TextBlock x:Name="EmptyText"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       Foreground="#BDC1C6"
                       FontSize="12.5"
                       FontFamily="Segoe UI"
                       Text="{ui:Loc NoMonitors}" />
        </StackPanel>
    </Border>
</Window>
